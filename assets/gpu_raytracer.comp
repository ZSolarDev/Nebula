#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct RGB {
    int red;
    int green;
    int blue;
};

layout(std430, binding = 0) buffer Input {
    int giSamples;
    int width;
    int height;
    float camX;
    float camY;
    float camZ;
    float camPitch;
    float camYaw;
    float fov;
    float bounceLightRandomness;
    float shadowsRandomness;
};

layout(std430, binding = 1) buffer Output {
    RGB pixels[__PXWIDTH * __PXHEIGHT]; // these get filled in with width and height at compile time
};

struct Ray {
    vec3 pos;
    vec3 dir;
};

struct Triangle {
    vec3 posA;
    vec3 posB;
    vec3 posC;
    vec3 normalA;
    vec3 normalB;
    vec3 normalC;
};

int getIndex(int x, int y) {
    return y * width + x;
}

RGB getPixel(int x, int y) {
    return pixels[getIndex(x, y)];
}

void setPixel(int x, int y, RGB color) {
    pixels[getIndex(x, y)] = color;
}

